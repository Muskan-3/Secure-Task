# Copy this file to .env and fill in real values:
#   Copy-Item .env.example .env
# .env is listed in .gitignore and must never be committed - it is where your
# actual secrets and passwords live, only on your own machine.

# --- App ---
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (used by docker-compose to start the postgres "db" service) ---
POSTGRES_USER=secure_task
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=securetask

# DATABASE_URL points the app at the "db" service defined in docker-compose.yml.
# The hostname "db" is resolved by Docker's internal network and only works when
# the app is itself running inside that same docker-compose project.
DATABASE_URL=postgresql+psycopg2://secure_task:change-me-to-a-strong-password@db:5432/securetask
